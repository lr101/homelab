# Absolute host paths; copy to .env and set for the selected host.
DEVICE_FOLDER_PATH=/absolute/path/to/homelab/medion
SHARED_FOLDER_PATH=/absolute/path/to/homelab/shared
LOCAL_BACKUP_PATH=/absolute/path/to/local-backups
# Medion override only: match UPLOAD_LOCATION in medion/immich-app/.env.
IMMICH_UPLOAD_LOCATION=/absolute/path/to/immich-uploads
